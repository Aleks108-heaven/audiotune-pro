<?xml version="1.0" encoding="utf-8"?>
<!--
  AudioTune Pro installer, built with WiX Toolset v5 (free, no admin rights needed
  to build). Produces a per-user MSI: installs to %LocalAppData%\Programs\AudioTune Pro
  (no UAC elevation prompt), and adds Start Menu + Desktop shortcuts using the app's icon.

  Build: dotnet publish the App project into CI-artefact, then run
    wix build installer/AudioTunePro.wxs -ext WixToolset.UI.wixext -arch x64 -o CI-artefact/AudioTunePro-Setup.msi
  from the repo root (see README.md).
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <Package Name="AudioTune Pro"
           Manufacturer="AudioTune Pro"
           Version="1.1.0"
           UpgradeCode="27E9C73A-268E-4A6D-A174-91E7BED677BE"
           Language="1033"
           Scope="perUser"
           Compressed="yes">

    <SummaryInformation Description="AudioTune Pro — System-Wide Equalizer" />
    <MajorUpgrade DowngradeErrorMessage="A newer version of AudioTune Pro is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="AppIcon.ico" SourceFile="..\src\AudioTunePro.App\Assets\icon.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon.ico" />
    <Property Id="ARPHELPLINK" Value="https://github.com/Aleks108-heaven/audiotune-pro" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsFolder" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="AudioTune Pro" />
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="AppProgramMenuFolder" Name="AudioTune Pro" />
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder">
      <Component Id="DesktopShortcut" Guid="4E6E7B1D-2C3A-4A1E-8B9F-7B6C2A9E5D44">
        <Shortcut Id="DesktopShortcutFile"
                  Name="AudioTune Pro"
                  Description="System-wide equalizer for Windows 11"
                  Target="[INSTALLFOLDER]AudioTunePro.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="AppIcon.ico" />
        <RegistryValue Root="HKCU" Key="Software\AudioTunePro" Name="DesktopShortcutInstalled"
                        Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <DirectoryRef Id="AppProgramMenuFolder">
      <Component Id="StartMenuShortcut" Guid="9B7B8C2A-6E9F-4C6B-9A3B-1B8C2C6C6A11">
        <Shortcut Id="StartMenuShortcutFile"
                  Name="AudioTune Pro"
                  Description="System-wide equalizer for Windows 11"
                  Target="[INSTALLFOLDER]AudioTunePro.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="AppIcon.ico" />
        <Shortcut Id="UninstallShortcut"
                  Name="Uninstall AudioTune Pro"
                  Description="Uninstall AudioTune Pro"
                  Target="[System64Folder]msiexec.exe"
                  Arguments="/x [ProductCode]" />
        <RemoveFolder Id="RemoveAppProgramMenuFolder" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\AudioTunePro" Name="StartMenuShortcutInstalled"
                        Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <Files Include="..\CI-artefact\**" />
    </ComponentGroup>

    <Feature Id="MainFeature" Title="AudioTune Pro" Level="1">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="DesktopShortcut" />
    </Feature>

    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <WixVariable Id="WixUILicenseRtf" Value="License.rtf" />

  </Package>
</Wix>
