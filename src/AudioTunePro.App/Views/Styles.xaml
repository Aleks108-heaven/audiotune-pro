<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Component styles built on the design tokens in AudioTunePro.Tokens.xaml
         (merged before this file in App.xaml). See design-system/components.md
         for the per-control rationale behind each choice here. -->

    <!-- Not a Style TargetType="Window": a window's own x:Class root element doesn't
         reliably pick up an implicit style for itself from merged Application resources
         (its child controls do). MainWindow.xaml sets these tokens directly instead.
         There is deliberately no implicit TextBlock style either: it would also restyle the
         text generated inside button/toggle templates and override their state colors. -->

    <!-- Global keyboard focus ring: a 2px accent-teal outline, offset from the control,
         applied to every Control (buttons, sliders, combo boxes, checkboxes, text boxes)
         via WPF's default FocusVisualStyle resource-key lookup. -->
    <Style x:Key="{x:Static SystemParameters.FocusVisualStyleKey}" TargetType="Control">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-2" SnapsToDevicePixels="True"
                               Stroke="{StaticResource focus-ring}" StrokeThickness="2"
                               RadiusX="4" RadiusY="4" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Panel: the bordered surface every group of controls sits on. -->
    <Style x:Key="Panel" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource surface-panel}" />
        <Setter Property="BorderBrush" Value="{StaticResource border-panel}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource radius-lg}" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="Effect" Value="{StaticResource elevation-panel}" />
    </Style>

    <!-- Grouped Panel variant: a bordered unit inside a panel (the Preset selector), where a
         dropdown, a name field and its actions belong visually together. No shadow: it sits on
         a panel, not on the window. -->
    <Style x:Key="PanelGroup" TargetType="Border">
        <Setter Property="BorderBrush" Value="{StaticResource border-panel}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource radius-lg}" />
        <Setter Property="Padding" Value="12,8" />
    </Style>

    <!-- Warning banner: unmet-dependency notices only, never routine confirmation. -->
    <Style x:Key="Banner" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource warn-bg}" />
        <Setter Property="BorderBrush" Value="{StaticResource warn-border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource radius-lg}" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <!-- Buttons -->
    <!-- Secondary weight (default): surface-raised fill, border-panel border, text-primary label. -->
    <Style TargetType="Button">
        <Setter Property="Background" Value="{StaticResource surface-raised}" />
        <Setter Property="Foreground" Value="{StaticResource text-primary}" />
        <Setter Property="BorderBrush" Value="{StaticResource border-panel}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontFamily" Value="{StaticResource font-sans}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="20,6" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource radius-md}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <!-- One step further up the panel/raised/border lightness scale. -->
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource border-panel}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource surface-raised}" />
                            <Setter Property="Foreground" Value="{StaticResource text-disabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Primary weight: exactly one per panel, accent-teal fill with ink-on-accent text. -->
    <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{StaticResource accent-teal}" />
        <Setter Property="Foreground" Value="{StaticResource ink-on-accent}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="{TemplateBinding Background}"
                            CornerRadius="{StaticResource radius-md}"
                            Opacity="1">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Opacity" Value="0.88" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bg" Property="Opacity" Value="1" />
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource surface-raised}" />
                            <Setter Property="Foreground" Value="{StaticResource text-disabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Destructive: secondary at rest, only turns signal-danger on hover or keyboard focus (Delete Preset). -->
    <Style x:Key="DestructiveButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource radius-md}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource signal-danger}" />
                            <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource signal-danger}" />
                            <Setter Property="Foreground" Value="{StaticResource ink-on-accent}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource signal-danger}" />
                            <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource signal-danger}" />
                            <Setter Property="Foreground" Value="{StaticResource ink-on-accent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource surface-raised}" />
                            <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource border-panel}" />
                            <Setter Property="Foreground" Value="{StaticResource text-disabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- TitleBar buttons: 46px-wide hit targets filling the full bar height, chrome-only. Like the
         native caption buttons they are not tab stops (Focusable=False); the keyboard equivalents
         are Win+Up/Down (maximize/restore/minimize) and Alt+F4. Glyphs are plain vector strokes (Path/Rectangle in
         MainWindow.xaml), per design-system/README.md's Iconography section, not an icon font. -->
    <Style x:Key="TitleBarButton" TargetType="Button">
        <Setter Property="Width" Value="46" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource text-secondary}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Arrow" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource surface-panel}" />
                            <Setter Property="Foreground" Value="{StaticResource text-primary}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Close is the one destructive control in the title bar. -->
    <Style x:Key="TitleBarCloseButton" TargetType="Button" BasedOn="{StaticResource TitleBarButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource signal-danger}" />
                            <Setter Property="Foreground" Value="{StaticResource ink-on-accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- PeakIndicator pill: filled dot + label on a 12%-opacity tint of the matching signal color. -->
    <Style x:Key="PeakIndicatorBadge" TargetType="Border">
        <Setter Property="CornerRadius" Value="{StaticResource radius-full}" />
        <Setter Property="Padding" Value="12,4" />
    </Style>

    <!-- ScrollBar: a slim rounded thumb in track-guide, no arrows, so the scrollbar that appears in
         the sidebar and the preset list stays inside the dark palette instead of the OS light theme.
         Vertical only (no horizontal scrolling is used anywhere in the app). -->
    <Style x:Key="ScrollPageButton" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="ScrollThumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="Bar" Margin="3,0" CornerRadius="{StaticResource radius-sm}"
                            Background="{StaticResource track-guide}" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bar" Property="Background" Value="{StaticResource text-secondary}" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Bar" Property="Background" Value="{StaticResource text-secondary}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="10" />
        <Setter Property="MinWidth" Value="10" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource ScrollPageButton}" />
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource ScrollThumb}" />
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource ScrollPageButton}" />
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ToolTip: dark popover surface instead of the OS light tooltip. -->
    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{StaticResource surface-panel}" />
        <Setter Property="Foreground" Value="{StaticResource text-primary}" />
        <Setter Property="BorderBrush" Value="{StaticResource border-panel}" />
        <Setter Property="FontFamily" Value="{StaticResource font-sans}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="{StaticResource radius-md}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- TextBox (preset name field): surface-raised input, radius-md, teal focus border. The resting border is
         track-guide (3:1 on the panel): an input's edge is what identifies it, so it can't be the faint panel border. -->
    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource surface-raised}" />
        <Setter Property="Foreground" Value="{StaticResource text-primary}" />
        <Setter Property="BorderBrush" Value="{StaticResource track-guide}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontFamily" Value="{StaticResource font-sans}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="8,5" />
        <Setter Property="CaretBrush" Value="{StaticResource text-primary}" />
        <Setter Property="SelectionBrush" Value="{StaticResource accent-teal}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource radius-md}" SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                      VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled"
                                      Focusable="False" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource text-secondary}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource focus-ring}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource text-disabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ComboBox: fully retemplated. The default template's dropdown popup ignores
         Background/Foreground property setters (its chrome comes from the OS theme),
         which is what made the preset list unreadable — this template owns every part. -->
    <Style x:Key="{x:Type ComboBoxItem}" TargetType="ComboBoxItem">
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="Foreground" Value="{StaticResource text-primary}" />
        <Setter Property="FontFamily" Value="{StaticResource font-sans}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bg" Background="Transparent" Padding="{TemplateBinding Padding}"
                            CornerRadius="{StaticResource radius-sm}">
                        <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource surface-raised}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource accent-teal}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="Background" Value="{StaticResource surface-raised}" />
        <Setter Property="Foreground" Value="{StaticResource text-primary}" />
        <Setter Property="BorderBrush" Value="{StaticResource track-guide}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontFamily" Value="{StaticResource font-sans}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="ToggleButton"
                                      Background="{TemplateBinding Background}"
                                      BorderBrush="{TemplateBinding BorderBrush}"
                                      BorderThickness="{TemplateBinding BorderThickness}"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                      ClickMode="Press" Focusable="False">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="{StaticResource radius-md}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="28" />
                                            </Grid.ColumnDefinitions>
                                            <Path Grid.Column="1" Data="M 0 0 L 4 4 L 8 0 Z"
                                                  Fill="{StaticResource text-secondary}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource text-secondary}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                          Margin="{TemplateBinding Padding}"
                                          TextElement.Foreground="{TemplateBinding Foreground}"
                                          HorizontalAlignment="Left" VerticalAlignment="Center" />
                        <Popup x:Name="Popup" Placement="Bottom" AllowsTransparency="True"
                               IsOpen="{TemplateBinding IsDropDownOpen}" Focusable="False" PopupAnimation="Slide">
                            <Border x:Name="DropDownBorder" Background="{StaticResource surface-panel}"
                                    BorderBrush="{StaticResource border-panel}" BorderThickness="1"
                                    CornerRadius="{StaticResource radius-md}"
                                    MinWidth="{TemplateBinding ActualWidth}" MaxHeight="320" Margin="0,4,0,12"
                                    Effect="{StaticResource elevation-popover}">
                                <ScrollViewer Margin="4" SnapsToDevicePixels="True">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- CheckBox retemplated as the Toggle component: label to the LEFT, switch at the right edge,
         on/off tracks never share a color. The off track carries a 1px track-guide outline so the
         switch has >=3:1 contrast against the panel. -->
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource text-secondary}" />
        <Setter Property="FontFamily" Value="{StaticResource font-sans}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ContentPresenter x:Name="Label" Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                        <Border x:Name="Track" Grid.Column="1" Width="36" Height="20"
                                CornerRadius="{StaticResource radius-full}"
                                Background="{StaticResource toggle-track-off}"
                                BorderBrush="{StaticResource track-guide}" BorderThickness="1">
                            <Ellipse x:Name="Knob" Width="14" Height="14" Fill="{StaticResource text-secondary}"
                                     HorizontalAlignment="Left" Margin="2,0,0,0" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{StaticResource toggle-track-on}" />
                            <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource toggle-track-on}" />
                            <Setter TargetName="Knob" Property="Fill" Value="{StaticResource ink-on-accent}" />
                            <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="Knob" Property="Margin" Value="0,0,2,0" />
                            <Setter Property="Foreground" Value="{StaticResource text-primary}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Track" Property="Background" Value="{StaticResource accent-muted}" />
                            <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource accent-muted}" />
                            <Setter TargetName="Knob" Property="Fill" Value="{StaticResource text-disabled}" />
                            <Setter Property="Foreground" Value="{StaticResource text-disabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- RadioButton (3D Surround mode): ring + teal dot for the one active choice. -->
    <Style TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource text-secondary}" />
        <Setter Property="FontFamily" Value="{StaticResource font-sans}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <StackPanel Orientation="Horizontal" Background="Transparent" VerticalAlignment="Center">
                        <Grid Width="16" Height="16" VerticalAlignment="Center">
                            <Ellipse x:Name="Ring" Fill="{StaticResource surface-raised}"
                                     Stroke="{StaticResource track-guide}" StrokeThickness="1.5" />
                            <Ellipse x:Name="Dot" Width="8" Height="8" Fill="{StaticResource accent-teal}"
                                     Visibility="Collapsed" />
                        </Grid>
                        <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Ring" Property="Stroke" Value="{StaticResource accent-teal}" />
                            <Setter Property="Foreground" Value="{StaticResource text-primary}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Ring" Property="Stroke" Value="{StaticResource accent-muted}" />
                            <Setter TargetName="Dot" Property="Fill" Value="{StaticResource accent-muted}" />
                            <Setter Property="Foreground" Value="{StaticResource text-disabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Invisible click-to-page area on a slider track. Without its own template WPF draws the OS button
         chrome here, which turns into a bright block when the slider is disabled. -->
    <Style x:Key="SliderTrackButton" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Vertical EQ fader slider. Handle color is bound per-instance to the band's live
         SignalState (see MainWindow.xaml) rather than fixed here, so it's a true function of gain.
         The rail and the 0 dB tick use track-guide so the travel range and unity point are visible.
         When the equalizer is bypassed the cap drops to accent-muted and loses its glow. -->
    <Style x:Key="EqFaderSlider" TargetType="Slider">
        <Setter Property="Orientation" Value="Vertical" />
        <Setter Property="Minimum" Value="-12" />
        <Setter Property="Maximum" Value="12" />
        <Setter Property="SmallChange" Value="0.5" />
        <Setter Property="LargeChange" Value="3" />
        <Setter Property="TickFrequency" Value="3" />
        <Setter Property="IsSnapToTickEnabled" Value="False" />
        <Setter Property="Background" Value="{StaticResource signal-safe}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid Background="Transparent">
                        <Border Width="2" Background="{StaticResource track-guide}"
                                HorizontalAlignment="Center" CornerRadius="1" />
                        <Border Width="36" Height="1" Background="{StaticResource track-guide}"
                                HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource SliderTrackButton}" />
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource SliderTrackButton}" />
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <!-- Background carries the live signal color in from the Slider (set per-band in MainWindow.xaml). -->
                                <Thumb x:Name="FaderThumb" Width="28" Height="14" Focusable="False"
                                       Background="{TemplateBinding Background}">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Grid>
                                                <!-- Soft glow behind the handle, in the same color, at low opacity. -->
                                                <Border x:Name="Glow" Background="{TemplateBinding Background}" Opacity="0.5"
                                                        CornerRadius="{StaticResource radius-sm}" Margin="-5,-8">
                                                    <Border.Effect>
                                                        <BlurEffect Radius="12" />
                                                    </Border.Effect>
                                                </Border>
                                                <Border x:Name="Cap" Background="{TemplateBinding Background}"
                                                        CornerRadius="{StaticResource radius-sm}" />
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter TargetName="Glow" Property="Opacity" Value="0" />
                                                    <Setter TargetName="Cap" Property="Background" Value="{StaticResource accent-muted}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Compact horizontal slider (Bass/Treble/Preamp and friends). Track fill and handle share one color,
         both dropping to accent-muted together when the row is disabled. Instances set Small/LargeChange
         to suit their range so keyboard steps are useful. -->
    <Style x:Key="HSlider" TargetType="Slider">
        <Setter Property="Height" Value="24" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="SmallChange" Value="0.5" />
        <Setter Property="LargeChange" Value="2" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid VerticalAlignment="Center" Background="Transparent">
                        <Border Height="4" Background="{StaticResource track-fill}" CornerRadius="2" />
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <!-- The filled portion, from Minimum up to the thumb: same color as the handle. -->
                                <RepeatButton x:Name="FillButton" Command="Slider.DecreaseLarge" BorderThickness="0" Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Height="4" Background="{TemplateBinding Background}" CornerRadius="2" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource SliderTrackButton}" />
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb x:Name="HandleThumb" Width="16" Height="16" Focusable="False">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border x:Name="Handle" Background="{StaticResource accent-teal}" CornerRadius="{StaticResource radius-sm}" />
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter TargetName="Handle" Property="Background" Value="{StaticResource accent-muted}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="FillButton" Property="Background" Value="{StaticResource accent-muted}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="True">
                            <Setter TargetName="FillButton" Property="Background" Value="{StaticResource accent-teal}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
