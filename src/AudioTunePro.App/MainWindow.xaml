<Window x:Class="AudioTunePro.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:AudioTunePro.App.ViewModels"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="AudioTune Pro — System-Wide Equalizer"
        Icon="pack://application:,,,/Assets/icon.ico"
        Height="700" Width="1020" MinHeight="620" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{StaticResource app-bg-gradient}"
        Foreground="{StaticResource text-primary}"
        FontFamily="{StaticResource font-sans}"
        FontSize="13"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextHintingMode="Fixed"
        Closing="Window_Closing"
        StateChanged="Window_StateChanged">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" />
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- TitleBar: chrome only, app glyph + name on the left, window controls on the right. -->
        <Grid Grid.Row="0" Height="40" Background="{StaticResource app-bg-top}"
              MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="14,0,0,0"
                        VerticalAlignment="Center" IsHitTestVisible="False">
                <TextBlock Text="&#xE9E9;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14"
                           Foreground="{StaticResource accent-teal}" VerticalAlignment="Center" />
                <TextBlock Text="AudioTune Pro" Margin="8,0,0,0" FontFamily="{StaticResource font-sans}"
                           FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource text-primary}"
                           VerticalAlignment="Center" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="MinimizeButton" Style="{StaticResource TitleBarButton}" Click="Minimize_Click">
                    <Path Width="10" Height="10" Stretch="None"
                          Data="M0,5 L10,5"
                          Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" />
                </Button>
                <Button x:Name="MaximizeButton" Style="{StaticResource TitleBarButton}" Click="Maximize_Click">
                    <Grid Width="10" Height="10">
                        <Rectangle x:Name="MaximizeIcon" Width="9" Height="9"
                                   Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" />
                        <Path x:Name="RestoreIcon" Visibility="Collapsed"
                              Data="M2,0 L2,2 M2,0 L10,0 L10,8 L8,8 M0,2 L8,2 L8,10 L0,10 Z"
                              Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" />
                    </Grid>
                </Button>
                <Button x:Name="CloseButton" Style="{StaticResource TitleBarCloseButton}" Click="Close_Click">
                    <Path Width="10" Height="10" Stretch="None"
                          Data="M0,0 L10,10 M10,0 L0,10"
                          Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" />
                </Button>
            </StackPanel>

            <Border Grid.ColumnSpan="2" VerticalAlignment="Bottom" Height="1" Background="{StaticResource divider}" />
        </Grid>

        <Grid Grid.Row="1" Margin="24,20,24,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,4">
                <TextBlock Text="AudioTune Pro" Style="{StaticResource wordmark}" />
                <TextBlock Text="System-Wide Equalizer" Style="{StaticResource subtitle}"
                           VerticalAlignment="Bottom" Margin="10,0,0,4" />
            </StackPanel>

            <!-- APO status banner: unmet dependency only, never a routine confirmation. -->
            <Border Grid.Row="1" Margin="0,10,0,16" Style="{StaticResource Banner}"
                    Visibility="{Binding IsApoInstalled, Converter={x:Static vm:BoolToCollapsedConverter.Instance}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="&#xE7BA;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                               FontSize="16" Foreground="{StaticResource signal-warn}"
                               VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBlock Grid.Column="1" Style="{StaticResource body}" TextWrapping="Wrap" VerticalAlignment="Center"
                               Text="Equalizer APO not found. Install it once, then AudioTune Pro will control it automatically." />
                    <Button Grid.Column="2" Content="Get Equalizer APO" Style="{StaticResource AccentButton}"
                            Margin="12,0,0,0" Click="DownloadApo_Click" />
                </Grid>
            </Border>

            <!-- Main content -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="32" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Left: presets + tone controls. Scrolls instead of clipping when the window
                     is shorter than the content (e.g. restored/default size vs. maximized). -->
                <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="PRESET" Style="{StaticResource section-label}" Margin="0,0,0,8" />
                    <ComboBox ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}"
                              DisplayMemberPath="Name" Margin="0,0,0,4" />
                    <TextBlock Text="{Binding SelectedPreset.Description}" Style="{StaticResource caption}"
                               TextWrapping="Wrap" Margin="0,0,0,10" />

                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="NewPresetNameBox" Grid.Column="0" Margin="0,0,6,0"
                                 Background="{StaticResource surface-raised}" Foreground="{StaticResource text-primary}"
                                 FontFamily="{StaticResource font-sans}" FontSize="14"
                                 BorderBrush="{StaticResource border-panel}" Padding="8,7" Text="My Preset" />
                        <Button Grid.Column="1" Content="Save As" Style="{StaticResource AccentButton}" Click="SavePreset_Click" />
                    </Grid>

                    <TextBlock Text="VOLUME" Style="{StaticResource section-label}" Margin="0,0,0,8" />
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="60" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="56" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="System" Style="{StaticResource control-label}" VerticalAlignment="Center" />
                        <Slider Grid.Column="1" Style="{StaticResource HSlider}" Minimum="0" Maximum="100"
                                Value="{Binding Volume}" />
                        <TextBlock Grid.Column="2" Text="{Binding Volume, StringFormat={}{0:0}%}"
                                   Style="{StaticResource value-lg}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                    </Grid>

                    <TextBlock Text="TONE" Style="{StaticResource section-label}" Margin="0,0,0,8" />
                    <StackPanel IsEnabled="{Binding EnableEqualizer}">
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="60" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="56" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Bass" Style="{StaticResource control-label}" VerticalAlignment="Center" />
                            <Slider Grid.Column="1" Style="{StaticResource HSlider}" Minimum="-12" Maximum="12"
                                    Value="{Binding BassDb}" />
                            <TextBlock Grid.Column="2" Text="{Binding BassDb, StringFormat={}{0:+0.0;-0.0;0.0} dB}"
                                       Style="{StaticResource value-lg}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                        </Grid>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="60" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="56" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Treble" Style="{StaticResource control-label}" VerticalAlignment="Center" />
                            <Slider Grid.Column="1" Style="{StaticResource HSlider}" Minimum="-12" Maximum="12"
                                    Value="{Binding TrebleDb}" />
                            <TextBlock Grid.Column="2" Text="{Binding TrebleDb, StringFormat={}{0:+0.0;-0.0;0.0} dB}"
                                       Style="{StaticResource value-lg}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                        </Grid>
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="60" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="56" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Preamp" Style="{StaticResource control-label}" VerticalAlignment="Center" />
                            <Slider Grid.Column="1" Style="{StaticResource HSlider}" Minimum="-24" Maximum="12"
                                    Value="{Binding PreampDb}" />
                            <TextBlock Grid.Column="2" Text="{Binding PreampDb, StringFormat={}{0:+0.0;-0.0;0.0} dB}"
                                       Style="{StaticResource value-lg}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                        </Grid>
                    </StackPanel>

                    <TextBlock Text="3D SURROUND" Style="{StaticResource section-label}" Margin="0,0,0,10" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <RadioButton GroupName="Surround" Content="Off" IsChecked="{Binding SurroundOff}" Margin="0,0,14,0" />
                        <RadioButton GroupName="Surround" Content="Auto" IsChecked="{Binding SurroundAuto}" Margin="0,0,14,0" />
                        <RadioButton GroupName="Surround" Content="Speakers" IsChecked="{Binding SurroundSpeakers}" Margin="0,0,14,0" />
                        <RadioButton GroupName="Surround" Content="Headphones" IsChecked="{Binding SurroundHeadphones}" />
                    </StackPanel>
                    <TextBlock Text="{Binding SurroundStatus}" Style="{StaticResource caption}" TextWrapping="Wrap" Margin="0,0,0,8" />
                    <Grid Margin="0,0,0,6" IsEnabled="{Binding SurroundActive}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="60" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="56" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Amount" Style="{StaticResource control-label}" VerticalAlignment="Center" />
                        <Slider Grid.Column="1" Style="{StaticResource HSlider}" Minimum="0" Maximum="1"
                                Value="{Binding SurroundAmount}" />
                        <TextBlock Grid.Column="2" Text="{Binding SurroundAmount, StringFormat={}{0:P0}}"
                                   Style="{StaticResource value-lg}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                    </Grid>
                    <Grid Margin="0,0,0,20" Visibility="{Binding ShowHrtfRow, Converter={x:Static vm:BoolToVisibleConverter.Instance}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding HrtfFileName}" Style="{StaticResource caption}"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   ToolTipService.ShowDuration="30000">
                            <TextBlock.ToolTip>
                                <TextBlock MaxWidth="320" TextWrapping="Wrap"
                                           Text="Optional. Without a file, Headphones mode uses built-in crossfeed, which works well for most people. An HRTF file is a 2-channel binaural impulse-response WAV for personalized 3D positioning — it isn't bundled with AudioTune Pro. Free sets: HeSuVi's bundled HRIRs, or the SADIE II / MIT KEMAR / CIPIC HRTF databases." />
                            </TextBlock.ToolTip>
                        </TextBlock>
                        <Button Grid.Column="1" Content="HRTF file…" Style="{StaticResource AccentButton}"
                                Margin="8,0,0,0" Click="BrowseHrtf_Click"
                                ToolTip="Pick a 2-channel HRTF/BRIR impulse-response .wav. None ships with the app — see HeSuVi or the SADIE II / MIT KEMAR / CIPIC HRTF databases." />
                        <Button Grid.Column="2" Content="Clear" Margin="6,0,0,0" Click="ClearHrtf_Click"
                                ToolTip="Remove the HRTF file and fall back to built-in crossfeed." />
                    </Grid>

                    <TextBlock Text="LIMITER — CLIPPING PROTECTION" Style="{StaticResource section-label}" Margin="0,0,0,10" />
                    <CheckBox Content="Auto-gain protection" IsChecked="{Binding AutoGainProtection}" Margin="0,0,0,10" />
                    <Grid Margin="0,0,0,4" IsEnabled="{Binding AutoGainProtection}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="60" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="56" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Ceiling" Style="{StaticResource control-label}" VerticalAlignment="Center" />
                        <Slider Grid.Column="1" Style="{StaticResource HSlider}" Minimum="-6" Maximum="0"
                                Value="{Binding LimiterCeilingDb}" />
                        <TextBlock Grid.Column="2" Text="{Binding LimiterCeilingDb, StringFormat={}{0:0.0} dB}"
                                   Style="{StaticResource value-lg}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,10,0,20">
                        <TextBlock Style="{StaticResource caption}" VerticalAlignment="Center" Margin="0,0,10,0">
                            <Run Text="Estimated peak: " />
                            <Run Text="{Binding EstimatedPeakDb, StringFormat={}{0:0.0} dB, Mode=OneWay}"
                                 FontFamily="{StaticResource font-mono}" Foreground="{StaticResource text-primary}" />
                        </TextBlock>
                        <!-- PeakIndicator: the same gain math as the faders, stated in words. -->
                        <Border Style="{StaticResource PeakIndicatorBadge}"
                                Background="{Binding PeakState, Converter={x:Static vm:SignalStateToTintBrushConverter.Instance}}">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="6" Height="6" VerticalAlignment="Center"
                                         Fill="{Binding PeakState, Converter={x:Static vm:SignalStateToBrushConverter.Instance}}" />
                                <TextBlock Margin="6,0,0,0" FontFamily="{StaticResource font-sans}" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{Binding PeakState, Converter={x:Static vm:SignalStateToBrushConverter.Instance}}"
                                           Text="{Binding PeakState, Converter={x:Static vm:SignalStateToLabelConverter.Instance}}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <CheckBox Content="Equalizer enabled" IsChecked="{Binding EnableEqualizer}" Margin="0,0,0,10" />
                    <CheckBox Content="Start with Windows" IsChecked="{Binding StartWithWindows}" Margin="0,0,0,10" />
                    <CheckBox Content="Show level meter" IsChecked="{Binding ShowLevelMeter}" Margin="0,0,0,10" />
                </StackPanel>
                </ScrollViewer>

                <!-- Right: graphic EQ -->
                <Border Grid.Column="2" Style="{StaticResource Panel}" Padding="20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="10-BAND GRAPHIC EQ" Style="{StaticResource section-label}" Margin="0,0,0,4" />

                        <ItemsControl Grid.Row="1" ItemsSource="{Binding Bands}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="4,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Text="{Binding GainDb, StringFormat={}{0:+0.0;-0.0;0.0}}"
                                                   Style="{StaticResource value-sm}"
                                                   Foreground="{Binding BandState, Converter={x:Static vm:SignalStateToBrushConverter.Instance}}"
                                                   HorizontalAlignment="Center" Margin="0,0,0,6" />
                                        <Slider Grid.Row="1" Style="{StaticResource EqFaderSlider}" Value="{Binding GainDb}"
                                                Background="{Binding BandState, Converter={x:Static vm:SignalStateToBrushConverter.Instance}}"
                                                HorizontalAlignment="Center" />
                                        <TextBlock Grid.Row="2" Text="{Binding Label}" Style="{StaticResource freq-label}"
                                                   HorizontalAlignment="Center" Margin="0,8,0,0" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,16,0,0">
                            <TextBlock Text="OUTPUT LEVEL" Style="{StaticResource section-label}" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <Border Width="240" Height="6" Background="{StaticResource track-fill}"
                                    CornerRadius="{StaticResource radius-full}" ClipToBounds="True">
                                <Border Background="{StaticResource level-meter-gradient}" HorizontalAlignment="Left"
                                        CornerRadius="{StaticResource radius-full}">
                                    <Border.RenderTransform>
                                        <ScaleTransform ScaleX="{Binding LevelMeter}" />
                                    </Border.RenderTransform>
                                    <Border.RenderTransformOrigin>
                                        <Point X="0" Y="0.5" />
                                    </Border.RenderTransformOrigin>
                                    <Border Width="240" Height="6" />
                                </Border>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- Footer -->
            <Grid Grid.Row="3" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" Style="{StaticResource caption}" VerticalAlignment="Center" />
                <Button Grid.Column="1" Content="Delete Preset" Style="{StaticResource DestructiveButton}" Margin="0,0,10,0" Click="DeletePreset_Click" />
                <Button Grid.Column="2" Content="Reset" Click="Reset_Click" />
            </Grid>
        </Grid>
    </Grid>
</Window>
