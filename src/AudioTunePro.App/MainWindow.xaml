<Window x:Class="AudioTunePro.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:AudioTunePro.App.ViewModels"
        Title="AudioTune Pro — System-Wide Equalizer"
        Icon="pack://application:,,,/Assets/icon.ico"
        Height="700" Width="1020" MinHeight="620" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Closing="Window_Closing"
        StateChanged="Window_StateChanged">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,4">
            <TextBlock Text="AudioTune Pro" FontSize="24" FontWeight="Bold" />
            <TextBlock Text="System-Wide Equalizer" Style="{StaticResource MutedText}"
                       VerticalAlignment="Bottom" Margin="10,0,0,4" FontSize="13" />
        </StackPanel>

        <!-- APO status banner -->
        <Border Grid.Row="1" Margin="0,10,0,16" Padding="12,8" CornerRadius="6"
                Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding ApoStatusText}" VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsApoInstalled}" Value="False">
                                    <Setter Property="Foreground" Value="{StaticResource WarnBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <Button Grid.Column="1" Content="Get Equalizer APO" Click="DownloadApo_Click"
                        Visibility="{Binding IsApoInstalled, Converter={x:Static vm:BoolToCollapsedConverter.Instance}}" />
            </Grid>
        </Border>

        <!-- Main content -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left: presets + tone controls -->
            <StackPanel Grid.Column="0">
                <TextBlock Text="PRESET" Style="{StaticResource SectionHeader}" />
                <ComboBox ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}"
                          DisplayMemberPath="Name" Margin="0,0,0,4" />
                <TextBlock Text="{Binding SelectedPreset.Description}" Style="{StaticResource MutedText}"
                           TextWrapping="Wrap" Margin="0,0,0,10" />

                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="NewPresetNameBox" Grid.Column="0" Margin="0,0,6,0"
                             Background="{StaticResource PanelBrush}" Foreground="{StaticResource TextBrush}"
                             BorderBrush="{StaticResource PanelBorderBrush}" Padding="6" Text="My Preset" />
                    <Button Grid.Column="1" Content="Save As" Style="{StaticResource AccentButton}" Click="SavePreset_Click" />
                </Grid>

                <TextBlock Text="TONE" Style="{StaticResource SectionHeader}" />
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="60" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="46" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Bass" VerticalAlignment="Center" />
                    <Slider Grid.Column="1" Style="{StaticResource HSlider}" Minimum="-12" Maximum="12"
                            Value="{Binding BassDb}" />
                    <TextBlock Grid.Column="2" Text="{Binding BassDb, StringFormat={}{0:+0.0;-0.0;0.0} dB}"
                               Style="{StaticResource MutedText}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                </Grid>
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="60" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="46" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Treble" VerticalAlignment="Center" />
                    <Slider Grid.Column="1" Style="{StaticResource HSlider}" Minimum="-12" Maximum="12"
                            Value="{Binding TrebleDb}" />
                    <TextBlock Grid.Column="2" Text="{Binding TrebleDb, StringFormat={}{0:+0.0;-0.0;0.0} dB}"
                               Style="{StaticResource MutedText}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                </Grid>
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="60" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="46" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Preamp" VerticalAlignment="Center" />
                    <Slider Grid.Column="1" Style="{StaticResource HSlider}" Minimum="-24" Maximum="12"
                            Value="{Binding PreampDb}" />
                    <TextBlock Grid.Column="2" Text="{Binding PreampDb, StringFormat={}{0:+0.0;-0.0;0.0} dB}"
                               Style="{StaticResource MutedText}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                </Grid>

                <TextBlock Text="LIMITER — CLIPPING PROTECTION" Style="{StaticResource SectionHeader}" />
                <CheckBox Content="Auto-gain protection" IsChecked="{Binding AutoGainProtection}" Margin="0,0,0,10" />
                <Grid Margin="0,0,0,4" IsEnabled="{Binding AutoGainProtection}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="60" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Ceiling" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Left">
                        <Button Content="−dB" Style="{StaticResource StepButton}" Width="40"
                                Click="CeilingDown_Click" />
                        <Border Width="64" Height="26" Margin="6,0" Background="{StaticResource TrackBrush}" CornerRadius="4">
                            <TextBlock Text="{Binding LimiterCeilingDb, StringFormat={}{0:0.0} dB}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" />
                        </Border>
                        <Button Content="+dB" Style="{StaticResource StepButton}" Width="40"
                                Click="CeilingUp_Click" />
                    </StackPanel>
                </Grid>
                <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,4,0,20">
                    <Run Text="Estimated peak: " />
                    <Run Text="{Binding EstimatedPeakDb, StringFormat={}{0:0.0} dB, Mode=OneWay}" />
                </TextBlock>

                <CheckBox Content="Equalizer enabled" IsChecked="{Binding EnableEqualizer}" Margin="0,0,0,10" />
                <CheckBox Content="Start with Windows" IsChecked="{Binding StartWithWindows}" Margin="0,0,0,10" />
                <CheckBox Content="Show level meter" IsChecked="{Binding ShowLevelMeter}" Margin="0,0,0,10" />
            </StackPanel>

            <!-- Right: graphic EQ -->
            <Border Grid.Column="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelBorderBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="10-BAND GRAPHIC EQ" Style="{StaticResource SectionHeader}" />

                    <ItemsControl Grid.Row="1" ItemsSource="{Binding Bands}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="4,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="{Binding GainDb, StringFormat={}{0:+0.0;-0.0;0.0}}"
                                               Style="{StaticResource MutedText}" HorizontalAlignment="Center" Margin="0,0,0,6" />
                                    <Slider Grid.Row="1" Style="{StaticResource EqFaderSlider}" Value="{Binding GainDb}"
                                            HorizontalAlignment="Center" />
                                    <TextBlock Grid.Row="2" Text="{Binding Label}" HorizontalAlignment="Center"
                                               Margin="0,8,0,0" FontSize="11" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,16,0,0">
                        <TextBlock Text="OUTPUT LEVEL" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <Border Width="240" Height="8" Background="{StaticResource TrackBrush}" CornerRadius="4" ClipToBounds="True">
                            <Border Background="{StaticResource AccentBrush}" HorizontalAlignment="Left" CornerRadius="4">
                                <Border.RenderTransform>
                                    <ScaleTransform ScaleX="{Binding LevelMeter}" />
                                </Border.RenderTransform>
                                <Border.RenderTransformOrigin>
                                    <Point X="0" Y="0.5" />
                                </Border.RenderTransformOrigin>
                                <Border Width="240" Height="8" />
                            </Border>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Footer -->
        <Grid Grid.Row="3" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
            <Button Grid.Column="1" Content="Delete Preset" Margin="0,0,10,0" Click="DeletePreset_Click" />
            <Button Grid.Column="2" Content="Reset" Click="Reset_Click" />
        </Grid>
    </Grid>
</Window>
